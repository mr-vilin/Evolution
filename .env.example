# Evolution 环境配置示例；复制为 .env 后填写，不提交 .env。

# MySQL
# 应用数据库账号密码；初始化后修改此值不会自动修改 MySQL 中的密码。
MYSQL_PASSWORD=
# MySQL root 密码，用于首次初始化、备份及运维；不要用于应用连接。
MYSQL_ROOT_PASSWORD=
# 本机 MySQL 映射端口，仅监听回环地址；容器间仍使用 mysql:3306。
MYSQL_HOST_PORT=13307
# 本地 Docker 外部数据卷。切换时先创建目标卷并保留原卷。
# MYSQL_VOLUME_NAME=organization-directory_mysql-data
# 应用与 Alembic 共用的 MySQL 连接串；本地 Docker 的库名和应用账号均为 evolution。
# 将 REPLACE_PASSWORD 换成 MYSQL_PASSWORD；密码中的 URL 保留字符需百分号编码。
DATABASE_URL=mysql+pymysql://evolution:REPLACE_PASSWORD@mysql:3306/evolution?charset=utf8mb4

# 应用与会话
# Compose 在本机暴露的 HTTP 端口；应用容器内部端口固定为 8000。
APP_PORT=8000
# 本地 Compose 使用的 evolution-runtime 镜像标签；正式发布由发布工具选定制品。
APP_IMAGE_TAG=local
# 管理端会话签名密钥，至少 32 字符随机值；更换后原有会话失效。
SESSION_SECRET=

# 飞书应用、登录与同步
# 飞书企业自建应用的 App ID。
FEISHU_APP_ID=
# 与 App ID 对应的应用密钥，仅在服务端使用。
FEISHU_APP_SECRET=
# 允许登录的飞书企业租户标识，应与自建应用所在企业对应。
FEISHU_TENANT_KEY=
# OAuth 登录回调地址；请改为真实 HTTPS 域名，并与飞书后台登记地址完全一致。
FEISHU_REDIRECT_URI=https://evolution.example.com/admin/auth/callback
# 仅用于展示已核验的权限名，逗号分隔；不是授权范围证明。
FEISHU_SCOPES=
# 事件监听器启动时是否触发全量核对；独立于每日定时任务。
FEISHU_RECONCILE_ON_STARTUP=false
# 事件监听器断线重连时是否触发全量核对；独立于每日定时任务。
FEISHU_RECONCILE_ON_RECONNECT=false
# 初始管理员的飞书 open_id 列表，逗号分隔；必须来自同一飞书应用。
INITIAL_ADMIN_OPEN_IDS=

# 飞书组织覆盖验收
# 真实企业验收的证据引用；未验收时留空。
COVERAGE_ACCEPTANCE_REFERENCE=
# 全员覆盖是否已通过真实企业验收；未验收时保持 false。
COVERAGE_ALL_MEMBERS_VERIFIED=false
# 无部门成员覆盖是否已通过真实企业验收；未验收时保持 false。
COVERAGE_DEPARTMENTLESS_VERIFIED=false

# 腾讯云财务
# 服务端只读凭据注册表，JSON 对象；键为凭据引用，值包含 label、secret_id、secret_key 和可选 token。
# 未接入时留空；登录用户只能选择引用，不能查看密钥。填写时建议用单引号包住单行 JSON。
TENCENT_CREDENTIALS=

# Agent 内部能力（反向代理禁止公开 /internal）
# 独立随机服务令牌，留空时所有内部能力请求均拒绝；与只读 API 密钥和管理员会话分离。
AGENT_SERVICE_TOKEN=
# 内部能力的身份策略，仅 production 或 test；不是部署环境选择器。
AGENT_ENVIRONMENT=production

# MCP 侧车（以 docker compose --profile agent 启用）
# 侧车监听地址；Compose 不发布宿主机端口。本机直接运行时建议用 127.0.0.1。
MCP_HOST=0.0.0.0
# MCP 服务监听端口，仅在容器私网内使用。
MCP_PORT=8001
# 与 AGENT_SERVICE_TOKEN 分别生成的独立随机令牌；仅交给受信 MCP 客户端。
MCP_SERVICE_TOKEN=
# MCP 调用后端内部能力的地址；Compose 内使用 app 服务名。
MCP_CAPABILITY_BASE_URL=http://app:8000
# production 仅 human_agent；隔离 test 可用 ci_agent。
MCP_ACTOR_TYPE=human_agent
# 侧车代表的可信调用主体标识；启用 MCP 时必填。
MCP_ACTOR_ID=
# 测试运行标识；test 必须以 test- 或 test_ 开头，production 可留空。
MCP_RUN_ID=
# 测试用例标识；可留空。
MCP_CASE_ID=
# 生产人工确认的最长等待秒数；超时不自动批准。
MCP_CONFIRMATION_TIMEOUT=60
